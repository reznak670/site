// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Track {
  id           String   @id @default(uuid())
  name         String
  desc         String   @default("")
  badge        String   @default("")
  badgeVariant String   @default("new")
  src          String
  createdAt    DateTime @default(now())
}

model MerchItem {
  id        String   @id @default(uuid())
  name      String
  desc      String   @default("")
  price     String
  image     String   @default("")
  createdAt DateTime @default(now())
}

model Concert {
  id        String   @id @default(uuid())
  date      String
  time      String   @default("")
  city      String
  venue     String
  ticketUrl String   @default("")
  desc      String   @default("")
  poster    String   @default("")
  createdAt DateTime @default(now())
}

model Order {
  id         String   @id @default(uuid())
  fio        String
  phone      String
  postalCode String
  email      String
  seen       Boolean  @default(false)
  createdAt  DateTime @default(now())

  items OrderItem[]
}

// itemId/itemName/itemPrice are a snapshot of the product at order time,
// intentionally decoupled from MerchItem so edits/deletes never rewrite past orders.
model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  itemId    String
  itemName  String
  itemPrice String
  qty       Int    @default(1)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
