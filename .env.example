ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-a-long-random-hex-string

# Postgres. Локально — любой доступный инстанс, в проде — строка из Neon /
# Vercel Postgres / Prisma Postgres (нужен прямой TCP-адрес, а не prisma+postgres://).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Vercel Blob: хранилище загруженных треков, картинок мерча и афиш.
# На Vercel подставляется автоматически при подключении Blob-стора к проекту;
# локально — `vercel env pull .env.local`. Без него загрузки в dev пишутся в public/.
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_BASE_URL=http://localhost:6781
