# Доступ к админке зашит в lib/auth.ts и работает без переменных окружения.
# Эти две — необязательные переопределения: заданы в Vercel — используются они,
# и тогда пароль с подписью сессии перестают быть публичными.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Vercel Blob — два отдельных стора, один стор не может одновременно отдавать
# и private-, и public-доступ.
# BLOB_READ_WRITE_TOKEN — приватный стор, данные коллекций (data/*.json:
# концерты, мерч, треки, заказы — там ФИО/телефон/почта покупателей).
# BLOB_PUBLIC_READ_WRITE_TOKEN — публичный стор, загруженные файлы (треки,
# картинки мерча, афиши) — должны открываться по прямой ссылке без авторизации.
# На Vercel переменные не подставляются сами — их нужно завести в Settings →
# Environment Variables вручную; локально — `vercel env pull .env.local`.
# Без токенов всё пишется в data/ и public/ на диск — это режим только для dev.
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_READ_WRITE_TOKEN=

NEXT_PUBLIC_BASE_URL=http://localhost:6781
