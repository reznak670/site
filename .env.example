# Доступ к админке зашит в lib/auth.ts и работает без переменных окружения.
# Эти две — необязательные переопределения: заданы в Vercel — используются они,
# и тогда пароль с подписью сессии перестают быть публичными.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Vercel Blob — единственное хранилище: и данные (data/*.json), и загруженные
# треки, картинки мерча, афиши. На Vercel переменная подставляется сама, когда
# к проекту подключён Blob-стор; локально — `vercel env pull .env.local`.
# Без токена всё пишется в data/ и public/ на диск — это режим только для dev.
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_BASE_URL=http://localhost:6781
